# --- Server config ---
# PostgreSQL connection string. For cloud Postgres (Render/Railway/Supabase),
# paste the provided connection URL here. Локально для розробки можна підняти
# Postgres і вказати, напр.:
DATABASE_URL="postgresql://psycho:psycho@localhost:5432/psycho_program?schema=public"

# Секрет для підпису JWT-токенів. У продакшні замініть на довгий випадковий рядок.
JWT_SECRET="change-me-in-production"

# Час життя токена.
JWT_EXPIRES_IN="7d"

# Порт HTTP-сервера.
PORT=4000

# Дозволені джерела для CORS (через кому). Має містити адресу фронтенду.
CORS_ORIGINS="http://localhost:5173,http://localhost:4173,https://psychoprogram.com,https://hrynchukk-cmyk.github.io"
